# Copy to backend/.env and edit. NEVER commit the real .env file.

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# First administrator, created automatically on first start (change the password after logging in)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Optional: Fernet key for encrypting face templates. Leave empty to auto-generate data/embedding.key
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMBEDDING_KEY=

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Recognition tuning (see docs/EVALUATION.md before changing)
MATCH_THRESHOLD=0.363
MATCH_MARGIN=0.05
LIVENESS_REQUIRED=true
RETENTION_DAYS=365
